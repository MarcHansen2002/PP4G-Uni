#version 430
#extension GL_GOOGLE_include_directive : require

#include "PressureSolver.glsl"

layout (local_size_x = 16, local_size_y = 16) in;

layout (std430, set = 0, binding = 0) buffer velocity_x
{
	float VelocityX[];
};
layout (std430, set = 0, binding = 1) buffer velocity_y
{
	float VelocityY[];
};
layout (std430, set = 0, binding = 2) readonly buffer pressure
{
	float Pressure[];
};

layout(push_constant) uniform Values
{
	int GridSizeX;
	int GridSizeY;
	float dTime;
	float CellSize;
};

#include "SmokeHelpers.glsl"

void main ()
{
	//float K = dTime / (FluidDensity * CellSize);
	float K = dTime / (1.0 * CellSize); // TODO: Pass fluiddensity as push constant instead of using this temporary hard code

	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	int x = id.x;
	int y = id.y;

	if (x >= GridSizeX || y >= GridSizeY)
	{
		return;
	}

	int i = GetCellIndex(x, y);

	// Horizontal velocities
	if (IsSolid(x - 1, y) || IsSolid(x, y))
	{}
	else
	{
		float pressureRight = Pressure[i];
		float pressureLeft = Pressure[GetCellIndex(x - 1, y)];
		VelocityX[GetVelocityXIndex(x, y)] -= K * (pressureRight - pressureLeft);
	}

	// Vertical velocities
	if (IsSolid(x, y - 1) || IsSolid(x, y))
	{}
	else
	{
		float pressureTop = Pressure[i];
		float pressureBottom = Pressure[GetCellIndex(x, y - 1)];
		VelocityY[GetVelocityYIndex(x, y)] -= K * (pressureTop - pressureBottom);
	}
}
