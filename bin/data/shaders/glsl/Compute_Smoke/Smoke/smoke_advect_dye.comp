#version 430
#extension GL_GOOGLE_include_directive : require

struct SmokeCell
{
	float Red;
	float Green;
	float Blue;
	float Density;
};

layout (local_size_x = 16, local_size_y = 16) in;

layout (std430, set = 0, binding = 0) readonly buffer velocity_x
{
	float VelocityX[];
};
layout (std430, set = 0, binding = 1) readonly buffer velocity_y
{
	float VelocityY[];
};
layout (std430, set = 0, binding = 2) writeonly buffer smoke
{
	SmokeCell Smoke[];
};
layout (std430, set = 0, binding = 3) writeonly buffer temp_smoke
{
	SmokeCell TempSmoke[];
};

layout(push_constant) uniform Values
{
	int GridSizeX;
	int GridSizeY;
	float dTime;
	float CellSize;
};

#include "SmokeHelpers.glsl"

void main ()
{
	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    int x = id.x;
    int y = id.y;
	int i = GetCellIndex(x, y);

	if (IsSolid(x, y))
	{
		TempSmoke[i].Density = 0.0f;
		TempSmoke[i].Red = 0.0f;
		TempSmoke[i].Blue = 0.0f;
		TempSmoke[i].Green = 0.0f;
		return;
	}

	vec2 pos = vec2(float(x) + 0.5, float(y) + 0.5);
	vec2 vel = GetVelocityAtGridPos(pos);
	vec2 posPrev = pos - vel * (dTime / CellSize);


	int width = GridSizeX;
    int height = GridSizeY;

    posPrev -= vec2(0.5, 0.5);

    posPrev.x = clamp(posPrev.x, 0.0, float(width - 1));
    posPrev.y = clamp(posPrev.y, 0.0, float(height - 1));

    int x0 = int(floor(posPrev.x));
    int y0 = int(floor(posPrev.y));

    int x1 = min(x0 + 1, width - 1);
    int y1 = min(y0 + 1, height - 1);

	int a = x0 + y0 * width;
	int b = x1 + y0 * width;
	int c = x0 + y1 * width;
	int d = x1 + y1 * width;

	TempSmoke[i].Density = SampleBilinear(Smoke[a].Density, Smoke[b].Density, Smoke[c].Density, Smoke[d].Density, fract(posPrev));
	TempSmoke[i].Red = SampleBilinear(Smoke[a].Red, Smoke[b].Red, Smoke[c].Red, Smoke[d].Red, fract(posPrev));
	TempSmoke[i].Green = SampleBilinear(Smoke[a].Green, Smoke[b].Green, Smoke[c].Green, Smoke[d].Green, fract(posPrev));
	TempSmoke[i].Blue = SampleBilinear(Smoke[a].Blue, Smoke[b].Blue, Smoke[c].Blue, Smoke[d].Blue, fract(posPrev));
}
